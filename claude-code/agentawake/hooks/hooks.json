{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -x '/Applications/AgentAwake.app/Contents/Helpers/agentawake' ] && '/Applications/AgentAwake.app/Contents/Helpers/agentawake' rules || true",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
